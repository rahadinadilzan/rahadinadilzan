def add_card():
    name = input(
        'Каким названием вы хотите назвать свою карточку?\n'
        'Если вы по случайности зашли сюда — введите 0: '
    )

    if name == '0':
        deystviye()
        return

    print('Введите 3 вопроса и 3 ответа.')

    questions = []
    answers = []

    for i in range(3):
        q = input(f'Вопрос {i+1}: ')
        a = input(f'Ответ {i+1}: ')
        questions.append(q)
        answers.append(a)

    card = Cards(questions, answers)
    cards.append(card)

    print(f'Карта "{name}" успешно добавлена!\n')
    deystviye()



