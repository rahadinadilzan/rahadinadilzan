from random import*
from time import*

users={
    'username':'password'
}
score=0
class Cards:
    def __init__(self,questions,answers):
        self.questions=questions
        self.answers=answers

    def start(self):
        global score
        score=0
        start_time=time()
        print('\nИгра началась!\n')
        for i in range(len(self.questions)):
            print(self.questions[i])
            user_answer=input('Ваш ответ:')
            if user_answer.lower()==self.answers[i].lower():
                score+=15
                print('Верно +15 очков\n')
            else:
                print(f'Неверно правильный ответ:{self.answers[i]}\n')
        print('Игра окончена!')
        print('Ваш счет:',score)
        print('Время',int(time()-start_time),'секунд\n')

