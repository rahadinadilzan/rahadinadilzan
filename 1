def register():
    x=input('Введите ваш никнейм(Никнейм должен содержать 5 и более символов):')
    length=len(x)
    if length<5:
        register()
    elif x in users:
        print('Этот логин уже занят.')
        register()
    else:
        y=input('Введите ваш пароль:')
        newuser={x:y}
        users.update(newuser)
        
        


def login():
    x=input('Введите ваш никнейм:')
    if x in users:
        y=input('Введите ваш пароль:')
        if users(x)==y:
            print('Вы успешно вошли!')


def account():
    x=input()
