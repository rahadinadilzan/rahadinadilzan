import pygame
import random

pygame.init()

width, height = 800, 400
win = pygame.display.set_mode((width, height))
pygame.display.set_caption("Dinosaur Game")

font = pygame.font.SysFont("Arial", 30)
big_font = pygame.font.SysFont("Arial", 50)

clock = pygame.time.Clock()

dino_width, dino_height = 50, 50
gravity = 1
jump_height = -15

obstacles = [
    {"w": 20, "h": 50, "speed": 10},
    {"w": 40, "h": 40, "speed": 7},
    {"w": 25, "h": 70, "speed": 12}
]

def reset_game():
    global dino_x, dino_y, dino_vel_y, is_jumping
    global obstacle, obstacle_x, score, speed_multiplier
    global game_over

    dino_x = 50
    dino_y = height - dino_height - 20
    dino_vel_y = 0
    is_jumping = False

    obstacle = random.choice(obstacles)
    obstacle_x = width

    score = 0
    speed_multiplier = 1
    game_over = False

dino_x = 50
dino_y = height - dino_height - 20
dino_vel_y = 0
is_jumping = False

obstacle = random.choice(obstacles)
obstacle_x = width

score = 0
speed_multiplier = 1

start_screen = True
game_over = False

run = True

while run:
    clock.tick(30)

    if not start_screen and not game_over:
        if (score // 100) % 2 == 0:
            win.fill((255, 255, 255))
            text_color = (0, 0, 0)
        else:
            win.fill((0, 255, 0))
            text_color = (0, 0, 0)
    else:
        win.fill((255, 255, 255))
        text_color = (0, 0, 0)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            run = False

    keys = pygame.key.get_pressed()

    if start_screen:
        text = big_font.render("Press SPACE to Start", True, (0, 0, 0))
        win.blit(text, (width // 2 - 250, height // 2 - 25))

        if keys[pygame.K_SPACE]:
            start_screen = False
            reset_game()

    elif not game_over:

        if not is_jumping and keys[pygame.K_SPACE]:
            is_jumping = True
            dino_vel_y = jump_height

        if is_jumping:
            dino_vel_y += gravity
            dino_y += dino_vel_y
            if dino_y >= height - dino_height - 20:
                dino_y = height - dino_height - 20
                is_jumping = False

        obstacle_x -= obstacle["speed"] * speed_multiplier

        if obstacle_x < -obstacle["w"]:
            obstacle = random.choice(obstacles)
            obstacle_x = width
            score += 25
            speed_multiplier += 0.05

        obstacle_y = height - obstacle["h"] - 20

        if (dino_x < obstacle_x + obstacle["w"] and
            dino_x + dino_width > obstacle_x and
            dino_y < obstacle_y + obstacle["h"] and
            dino_y + dino_height > obstacle_y):
            game_over = True

        pygame.draw.rect(win, (0, 0, 0), (dino_x, dino_y, dino_width, dino_height))
        pygame.draw.rect(win, (0, 0, 0), (obstacle_x, obstacle_y, obstacle["w"], obstacle["h"]))

    else:
        text1 = big_font.render("GAME OVER", True, (0, 0, 0))
        text2 = font.render("Press R to Restart", True, (0, 0, 0))
        win.blit(text1, (width // 2 - 140, height // 2 - 50))
        win.blit(text2, (width // 2 - 130, height // 2 + 10))

        if keys[pygame.K_r]:
            reset_game()

    score_text = font.render("Score: " + str(score), True, text_color)
    win.blit(score_text, (10, 10))

    pygame.display.update()

pygame.quit()
